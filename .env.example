# Kubernetes Playground Backend Configuration

# Server Configuration
PORT=3001
NODE_ENV=production

# Kubernetes Configuration
# Path to your kubeconfig file
KUBECONFIG=/path/to/your/kubeconfig

# If running in cluster, use service account
# KUBECONFIG=/var/run/secrets/kubernetes.io/serviceaccount/token

# Google Cloud Configuration (if using GKE)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Backend URL for frontend
BACKEND_URL=https://your-backend-url.com

# Security Configuration
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX=100
SESSION_TIMEOUT=1800000

# Database Configuration (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/k8splayground

# Redis Configuration (optional, for session storage)
# REDIS_URL=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=/var/log/k8s-playground.log

# Feature Flags
ENABLE_REAL_CLUSTER=true
ENABLE_WEBSOCKET=true
ENABLE_AUDIT_LOG=true