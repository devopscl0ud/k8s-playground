# ============================================================================
# Kubernetes Playground Backend Configuration
# ============================================================================

# Server Configuration
PORT=3001
NODE_ENV=production

# ============================================================================
# Kubernetes Configuration (Choose ONE option)
# ============================================================================

# Option 1: Use kubeconfig file (Recommended for VM deployment)
KUBECONFIG=/etc/k8s-playground/kubeconfig

# Option 2: In-cluster service account (if running in Kubernetes)
# KUBECONFIG=/var/run/secrets/kubernetes.io/serviceaccount

# Option 3: Use environment-based configuration
# KUBE_API_URL=https://k8s-master:6443
# KUBE_CA_FILE=/path/to/ca.crt
# KUBE_TOKEN=<your-service-account-token>

# ============================================================================
# Backend Access Configuration
# ============================================================================

# URL for frontend to reach backend
BACKEND_URL=http://localhost:3001

# CORS configuration
CORS_ORIGIN=*

# ============================================================================
# Security Configuration
# ============================================================================

# Rate limiting
RATE_LIMIT_WINDOW=60000          # milliseconds (60 seconds)
RATE_LIMIT_MAX=100               # requests per window

# Session management
SESSION_TIMEOUT=1800000          # milliseconds (30 minutes)

# API Authentication (optional)
# API_KEY=<generate-with: openssl rand -base64 32>

# ============================================================================
# WebSocket Configuration
# ============================================================================

ENABLE_WEBSOCKET=true
WS_UPDATE_INTERVAL=5000          # milliseconds (frequency of cluster updates)

# ============================================================================
# Logging Configuration
# ============================================================================

LOG_LEVEL=info                   # debug, info, warn, error
# LOG_FILE=/var/log/k8s-playground.log

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_REAL_CLUSTER=true         # Connect to real Kubernetes cluster
ENABLE_AUDIT_LOG=true            # Log all API requests

# ============================================================================
# Database Configuration (Optional - for future use)
# ============================================================================

# DATABASE_URL=postgresql://user:password@localhost:5432/k8splayground
# DATABASE_POOL_SIZE=10
# DATABASE_TIMEOUT=5000

# ============================================================================
# Redis Configuration (Optional - for caching & sessions)
# ============================================================================

# REDIS_URL=redis://localhost:6379
# REDIS_DB=0
# REDIS_TTL=3600

# ============================================================================
# GCP Configuration (if using Google Cloud)
# ============================================================================

# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# ============================================================================
# HTTPS Configuration (for production)
# ============================================================================

# HTTPS_PORT=3443
# HTTPS_KEY=/path/to/private-key.pem
# HTTPS_CERT=/path/to/certificate.pem

# ============================================================================
# Monitoring & Analytics
# ============================================================================

# PROMETHEUS_ENABLED=true
# PROMETHEUS_PORT=9090
# SENTRY_DSN=<your-sentry-dsn-if-using>